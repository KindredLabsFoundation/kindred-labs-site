@page
@model IndexModel
@inject IStringLocalizer<KindredLabs.Web.Resources.Pages.Account.Manage.Index> Localizer

@{
    ViewData["Title"] = Localizer["Profile"];
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row gap-8">
        <aside class="md:w-1/4">
            <partial name="_ManageNav" />
        </aside>
        <main class="flex-1 max-w-md">
            <h1 class="text-xl sm:text-2xl font-bold text-kindred-gold mb-8">@ViewData["Title"]</h1>
            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="profile-form" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm mb-4" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Username" class="block text-sm font-medium text-kindred-text mb-1">@Localizer["Username"]</label>
                    <input asp-for="Username" class="w-full bg-white/10 border border-white/20 rounded px-3 py-2 text-kindred-text opacity-50 cursor-not-allowed" disabled />
                </div>

                <div class="mb-6">
                    <label asp-for="Input.PhoneNumber" class="block text-sm font-medium text-kindred-text mb-1">@Localizer["Phone number"]</label>
                    <input asp-for="Input.PhoneNumber" class="w-full bg-white/5 border border-white/20 rounded px-3 py-2 text-kindred-text focus:outline-none focus:border-kindred-gold" placeholder="Phone number" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-red-400 text-sm mt-1 block"></span>
                </div>

                <button id="update-profile-button" type="submit" class="bg-transparent border-none p-0 text-kindred-gold hover:opacity-70 transition-opacity cursor-pointer font-ui text-base">@Localizer["Save"]</button>
            </form>
        </main>
    </div>
</div>

@page
@model LogoutModel
@inject IStringLocalizer<KindredLabs.Web.Resources.Pages.Account.Logout> Localizer

@{
    ViewData["Title"] = Localizer["Log out"];
}

<div class="max-w-md mx-auto px-4 py-16">
    <h1 class="text-2xl font-bold text-kindred-gold mb-8">@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            var currentCulture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
            <form class="form-inline" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" asp-route-culture="@currentCulture" method="post">
                <button type="submit" class="bg-transparent border-none p-0 text-kindred-gold hover:opacity-70 transition-opacity cursor-pointer font-ui text-base">@Localizer["Click here to Logout"]</button>
            </form>
        }
        else
        {
            <p class="text-kindred-text">@Localizer["You have successfully logged out of the application."]</p>
        }
    }
</div>

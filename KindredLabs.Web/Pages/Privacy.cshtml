@page
@{
    if (Request.Query["embed"] == "true")
    {
        Layout = null;
    }
}
@model PrivacyModel
@{
    ViewData["Title"] = Model.Localizer["Title"];
}

<div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-wordmark text-kindred-gold mb-2">@Model.Localizer["Title"]</h1>
    <p class="text-kindred-text/60 mb-8">@Model.Localizer["LastUpdated"]</p>

    <div class="prose prose-invert max-w-none text-kindred-text space-y-12">
        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section1_Title"]</h2>
            <div class="space-y-4">
                <p>@Model.Localizer["Section1_Text1"]</p>
                <p>@Model.Localizer["Section1_Text2"]</p>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section2_Title"]</h2>
            <div class="space-y-8">
                <div>
                    <h3 class="text-xl font-ui text-kindred-gold/80 mb-2">@Model.Localizer["Section2_1_Title"]</h3>
                    <p>@Model.Localizer["Section2_1_Text"]</p>
                </div>
                <div>
                    <h3 class="text-xl font-ui text-kindred-gold/80 mb-2">@Model.Localizer["Section2_2_Title"]</h3>
                    <p>@Model.Localizer["Section2_2_Text"]</p>
                </div>
                <div>
                    <h3 class="text-xl font-ui text-kindred-gold/80 mb-2">@Model.Localizer["Section2_3_Title"]</h3>
                    <p>@Model.Localizer["Section2_3_Text"]</p>
                </div>
                <div>
                    <h3 class="text-xl font-ui text-kindred-gold/80 mb-2">@Model.Localizer["Section2_4_Title"]</h3>
                    <p>@Model.Localizer["Section2_4_Text"]</p>
                </div>
                <div>
                    <h3 class="text-xl font-ui text-kindred-gold/80 mb-2">@Model.Localizer["Section2_5_Title"]</h3>
                    <p>@Model.Localizer["Section2_5_Text"]</p>
                </div>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section3_Title"]</h2>
            <div class="space-y-4">
                <p>@Model.Localizer["Section3_Intro"]</p>
                <ul class="list-disc pl-6 space-y-2">
                    <li>@Model.Localizer["Section3_Item1"]</li>
                    <li>@Model.Localizer["Section3_Item2"]</li>
                    <li>@Model.Localizer["Section3_Item3"]</li>
                    <li>@Model.Localizer["Section3_Item4"]</li>
                    <li>@Model.Localizer["Section3_Item5"]</li>
                </ul>
                <p>@Model.Localizer["Section3_Outro"]</p>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section4_Title"]</h2>
            <div class="space-y-4">
                <p>@Model.Localizer["Section4_Intro"]</p>
                <ul class="list-disc pl-6 space-y-2">
                    <li>@Html.Raw(Model.Localizer["Section4_Item1"])</li>
                    <li>@Html.Raw(Model.Localizer["Section4_Item2"])</li>
                    <li>@Html.Raw(Model.Localizer["Section4_Item3"])</li>
                </ul>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section5_Title"]</h2>
            <div class="space-y-4">
                <p>@Model.Localizer["Section5_Intro"]</p>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-white/20">
                                <th class="py-2 pr-4 font-bold">@Model.Localizer["Section5_Col1"]</th>
                                <th class="py-2 pr-4 font-bold">@Model.Localizer["Section5_Col2"]</th>
                                <th class="py-2 font-bold">@Model.Localizer["Section5_Col3"]</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/10">
                            <tr>
                                <td class="py-2 pr-4">Supabase</td>
                                <td class="py-2 pr-4">@Model.Localizer["Section5_Supabase_Purpose"]</td>
                                <td class="py-2">@Model.Localizer["Section5_Supabase_Data"]</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-4">Postmark</td>
                                <td class="py-2 pr-4">@Model.Localizer["Section5_Postmark_Purpose"]</td>
                                <td class="py-2">@Model.Localizer["Section5_Postmark_Data"]</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-4">Plausible Analytics</td>
                                <td class="py-2 pr-4">@Model.Localizer["Section5_Plausible_Purpose"]</td>
                                <td class="py-2">@Model.Localizer["Section5_Plausible_Data"]</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-4">Google Cloud Run</td>
                                <td class="py-2 pr-4">@Model.Localizer["Section5_Google_Purpose"]</td>
                                <td class="py-2">@Model.Localizer["Section5_Google_Data"]</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p>@Model.Localizer["Section5_Outro"]</p>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section6_Title"]</h2>
            <div class="space-y-4">
                <p>@Model.Localizer["Section6_Intro"]</p>
                <ul class="list-disc pl-6 space-y-2">
                    <li>@Html.Raw(Model.Localizer["Section6_Item1"])</li>
                    <li>@Html.Raw(Model.Localizer["Section6_Item2"])</li>
                    <li>@Html.Raw(Model.Localizer["Section6_Item3"])</li>
                    <li>@Html.Raw(Model.Localizer["Section6_Item4"])</li>
                    <li>@Html.Raw(Model.Localizer["Section6_Item5"])</li>
                </ul>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section7_Title"]</h2>
            <div class="space-y-4">
                <p>@Model.Localizer["Section7_Text"]</p>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section8_Title"]</h2>
            <div class="space-y-4">
                <p>@Model.Localizer["Section8_Intro"]</p>
                <ul class="list-disc pl-6 space-y-2">
                    <li>@Model.Localizer["Section8_Item1"]</li>
                    <li>@Model.Localizer["Section8_Item2"]</li>
                    <li>@Model.Localizer["Section8_Item3"]</li>
                    <li>@Model.Localizer["Section8_Item4"]</li>
                    <li>@Model.Localizer["Section8_Item5"]</li>
                </ul>
                <p>@Model.Localizer["Section8_Text1"]</p>
                <p>@Model.Localizer["Section8_Text2"]</p>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section9_Title"]</h2>
            <div class="space-y-4">
                <p>@Model.Localizer["Section9_Text"]</p>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section10_Title"]</h2>
            <div class="space-y-4">
                <p>@Model.Localizer["Section10_Text"]</p>
            </div>
        </section>

        <section>
            <h2 class="text-2xl font-ui text-kindred-gold mb-4 border-b border-white/10 pb-2">@Model.Localizer["Section11_Title"]</h2>
            <div class="space-y-4">
                <p class="font-bold">Kindred Labs Foundation</p>
                <p><a href="mailto:privacy@@kindredlabsfoundation.org" class="text-kindred-gold hover:underline">privacy@@kindredlabsfoundation.org</a></p>
            </div>
        </section>

        @if (Request.Query["embed"] == "true")
        {
            <div class="mt-12 py-8 border-t border-white/10 flex justify-center">
                <a href="javascript:void(0)" 
                   onclick="window.parent.acceptPolicy('PrivacyPolicy', 'Input_AcceptedPrivacyPolicy')"
                   class="text-kindred-gold font-bold underline text-xl hover:opacity-70 transition-opacity">
                    I Accept the Privacy Policy
                </a>
            </div>
        }
    </div>
</div>
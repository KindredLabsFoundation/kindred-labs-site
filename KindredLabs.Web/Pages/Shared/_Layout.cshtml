@using Microsoft.AspNetCore.Identity
@using KindredLabs.Core.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<Resources.Pages.Shared._Layout> Localizer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="/css/tailwind.css" />
    <script src="https://kit.fontawesome.com/a348379595.js" crossorigin="anonymous"></script>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@ViewData["CanonicalUrl"]" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:url" content="@ViewData["CanonicalUrl"]" />
    <meta property="og:type" content="website" />
    <link rel="alternate" hreflang="en" href="https://www.kindredlabsfoundation.org/" />
    <link rel="alternate" hreflang="es" href="https://www.kindredlabsfoundation.org/es/" />
    <link rel="alternate" hreflang="x-default" href="https://www.kindredlabsfoundation.org/" />
    @await Html.PartialAsync("_JsonLd")
</head>
<body id="page-top" class="min-h-screen flex flex-col">
    @{
        var currentCulture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    }
    <header class="sticky top-0 z-50 bg-kindred-dark">
        <nav class="bg-black/20 py-4">
            <div class="container mx-auto px-4 flex justify-between items-center">
                <a class="font-wordmark font-semibold text-xl sm:text-2xl text-kindred-gold no-underline" asp-page="/Index" asp-route-culture="@currentCulture">Kindred Labs</a>
                
                <div class="flex items-center space-x-4">
                    <button id="menuToggle" class="lg:hidden text-kindred-text focus:outline-none" aria-label="Toggle navigation">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>

                <div id="mobileMenu" class="hidden lg:flex w-full lg:w-auto lg:items-center flex-col lg:flex-row lg:space-x-6 mt-4 lg:mt-0 absolute lg:relative top-full inset-x-0 z-50 bg-kindred-dark lg:bg-transparent shadow-lg lg:shadow-none text-end lg:text-start lg:ml-auto lg:mr-6" style="margin-top: 0;">
                    <div class="px-4 py-3 lg:p-0">
                        <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors" asp-page="/Index" asp-route-culture="@currentCulture">@Localizer["Home"]</a>
                    </div>
                    <div class="px-4 py-3 lg:p-0">
                        <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors" asp-page="/Codex" asp-route-culture="@currentCulture">@Localizer["Codex"]</a>
                    </div>
                    <div class="px-4 py-3 lg:p-0">
                        <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors" asp-page="/Framework/Index" asp-route-culture="@currentCulture">@Localizer["Framework"]</a>
                    </div>
                    <div class="px-4 py-3 lg:p-0">
                        <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors" asp-page="/CDRP/Index" asp-route-culture="@currentCulture">@Localizer["CDRP"]</a>
                    </div>
                    <div class="px-4 py-3 lg:p-0">
                        <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors" asp-page="/About" asp-route-culture="@currentCulture">@Localizer["About"]</a>
                    </div>
                    <div class="px-4 py-3 lg:p-0">
                        <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors" asp-page="/Contact" asp-route-culture="@currentCulture">@Localizer["Contact"]</a>
                    </div>
                    
                    <div class="lg:hidden">
                        <div class="px-4 py-3 border-t border-white/10 mt-2">
                            <form asp-page="/Culture/Set" asp-route-culture="@currentCulture" method="post" id="cultureFormMobile">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <div class="flex items-center justify-end space-x-2">
                                    <span class="text-sm text-kindred-text opacity-70">@Localizer["Language"]:</span>
                                    <select name="culture" onchange="this.form.submit()" class="bg-transparent text-kindred-text border border-white/20 rounded px-1 text-sm culture-select">
                                        <option value="en" selected="@(currentCulture == "en")">English</option>
                                        <option value="es" selected="@(currentCulture == "es")">Español</option>
                                    </select>
                                </div>
                            </form>
                        </div>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            var userMobile = await UserManager.GetUserAsync(User);
                            var fullNameMobile = userMobile != null && (!string.IsNullOrEmpty(userMobile.FirstName) || !string.IsNullOrEmpty(userMobile.LastName))
                                ? $"{userMobile.FirstName} {userMobile.LastName}".Trim()
                                : User.Identity?.Name;
                            <div class="px-4 py-3">
                                <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors" asp-page="/Account/Index" asp-route-culture="@currentCulture">@fullNameMobile</a>
                            </div>
                            <div class="px-4 py-3">
                                <form asp-page="/Account/Logout" asp-route-culture="@currentCulture" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post" id="logoutFormMobile">
                                    <a href="javascript:document.getElementById('logoutFormMobile').submit();" class="text-kindred-text no-underline hover:text-kindred-gold transition-colors">@Localizer["Logout"]</a>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="px-4 py-3">
                                <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors" asp-page="/Account/Register" asp-route-culture="@currentCulture">@Localizer["Register"]</a>
                            </div>
                            <div class="px-4 py-3">
                                <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors" asp-page="/Account/Login" asp-route-culture="@currentCulture">@Localizer["Login"]</a>
                            </div>
                        }
                    </div>
                </div>

                <button id="drawerToggle" class="hidden lg:block text-kindred-text hover:text-kindred-gold transition-colors focus:outline-none" aria-label="Account and Settings">
                    <i class="fa-solid fa-gear"></i>
                </button>
            </div>
        </nav>
    </header>

    <div id="drawerOverlay" class="fixed inset-0 bg-black/60 z-[60] hidden transition-opacity duration-300 opacity-0 top-[64px]" aria-hidden="true"></div>
    
    <div id="accountDrawer" class="fixed top-0 right-0 w-80 bg-kindred-dark z-[70] shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out p-6 overflow-y-auto top-[64px]" style="height: calc(100vh - 64px);">
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-kindred-gold font-wordmark text-xl font-semibold">@Localizer["Account & Settings"]</h2>
            <button id="closeDrawer" class="text-kindred-text hover:text-kindred-gold focus:outline-none" aria-label="Close drawer">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <div class="space-y-8">
            <div>
                <h3 class="text-sm uppercase tracking-wider text-kindred-text opacity-50 mb-4">@Localizer["Language"]</h3>
                <form asp-page="/Culture/Set" asp-route-culture="@currentCulture" method="post" id="cultureFormDrawer">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <select name="culture" onchange="this.form.submit()" class="w-full bg-black/20 text-kindred-text border border-white/10 rounded-md p-2 focus:border-kindred-gold outline-none transition-colors">
                        <option value="en" selected="@(currentCulture == "en")">English</option>
                        <option value="es" selected="@(currentCulture == "es")">Español</option>
                    </select>
                </form>
            </div>

            <div class="border-t border-white/10 pt-8">
                <h3 class="text-sm uppercase tracking-wider text-kindred-text opacity-50 mb-4">@Localizer["Account"]</h3>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            var fullName = user != null && (!string.IsNullOrEmpty(user.FirstName) || !string.IsNullOrEmpty(user.LastName))
                                ? $"{user.FirstName} {user.LastName}".Trim()
                                : User.Identity?.Name;
                            <div class="mb-4">
                                <p class="text-kindred-text text-sm mb-1 opacity-70">@Localizer["Signed in as"]</p>
                                <p class="text-kindred-gold font-semibold break-all">@fullName</p>
                            </div>
                            <ul class="space-y-4">
                                @if (User.IsInRole(AppRoles.OwnerRole) || User.IsInRole(AppRoles.AdminRole))
                                {
                                    <li>
                                        <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors flex items-center" asp-page="/Admin/Index" asp-route-culture="@currentCulture">
                                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                                            </svg>
                                            @Localizer["Admin Dashboard"]
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors flex items-center" asp-page="/Account/Index" asp-route-culture="@currentCulture">
                                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                        </svg>
                                        @Localizer["Manage Profile"]
                                    </a>
                                </li>
                                <li>
                                    <form asp-page="/Account/Logout" asp-route-culture="@currentCulture" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post" id="logoutFormDrawer">
                                        <a href="javascript:document.getElementById('logoutFormDrawer').submit();" class="text-kindred-text no-underline hover:text-kindred-gold transition-colors flex items-center">
                                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                            </svg>
                                            @Localizer["Logout"]
                                        </a>
                                    </form>
                                </li>
                            </ul>
                        }
                else
                {
                    <ul class="space-y-4">
                        <li>
                            <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors flex items-center" asp-page="/Account/Register" asp-route-culture="@currentCulture">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                                </svg>
                                @Localizer["Register"]
                            </a>
                        </li>
                        <li>
                            <a class="text-kindred-text no-underline hover:text-kindred-gold transition-colors flex items-center" asp-page="/Account/Login" asp-route-culture="@currentCulture">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                </svg>
                                @Localizer["Login"]
                            </a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </div>
    <main role="main" class="max-w-7xl mx-auto px-4 codex-main flex-grow">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-8">
        <div class="max-w-7xl mx-auto px-4 text-kindred-text/60 text-sm">
            <div>&copy; @DateTime.Now.Year - Kindred Labs Foundation</div>
            <div class="mt-2 space-x-4">
                <a asp-page="/Privacy" asp-route-culture="@currentCulture" class="hover:text-kindred-gold transition-colors">@Localizer["Privacy Policy"]</a>
                <a asp-page="/Terms" asp-route-culture="@currentCulture" class="hover:text-kindred-gold transition-colors">@Localizer["Terms of Service"]</a>
            </div>
        </div>
    </footer>

    <script src="~/js/form-actions.js" asp-append-version="true"></script>
    <script src="~/js/cookie-consent.js" asp-append-version="true"></script>
    <script src="~/js/policy-modal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        const menuToggle = document.getElementById('menuToggle');
        const mobileMenu = document.getElementById('mobileMenu');
        const drawerToggle = document.getElementById('drawerToggle');
        const accountDrawer = document.getElementById('accountDrawer');
        const closeDrawer = document.getElementById('closeDrawer');
        const drawerOverlay = document.getElementById('drawerOverlay');

        function openMobileMenu() {
            mobileMenu.classList.remove('hidden');
            drawerOverlay.classList.remove('hidden');
            drawerOverlay.style.top = mobileMenu.getBoundingClientRect().bottom + 'px';
            setTimeout(() => {
                drawerOverlay.classList.add('opacity-100');
            }, 10);
            document.body.style.overflow = 'hidden';
        }

        function closeMobileMenu() {
            mobileMenu.classList.add('hidden');
            drawerOverlay.style.top = '64px';
            if (accountDrawer.classList.contains('translate-x-full')) {
                drawerOverlay.classList.remove('opacity-100');
                setTimeout(() => {
                    drawerOverlay.classList.add('hidden');
                }, 300);
                document.body.style.overflow = '';
            }
        }

        function openDrawer() {
            accountDrawer.classList.remove('translate-x-full');
            drawerOverlay.classList.remove('hidden');
            setTimeout(() => {
                drawerOverlay.classList.add('opacity-100');
            }, 10);
            document.body.style.overflow = 'hidden';
        }

        function closeDrawerFunc() {
            accountDrawer.classList.add('translate-x-full');
            if (mobileMenu.classList.contains('hidden')) {
                drawerOverlay.classList.remove('opacity-100');
                setTimeout(() => {
                    drawerOverlay.classList.add('hidden');
                }, 300);
                document.body.style.overflow = '';
            }
        }

        menuToggle.addEventListener('click', function() {
            if (mobileMenu.classList.contains('hidden')) {
                openMobileMenu();
            } else {
                closeMobileMenu();
            }
        });

        drawerToggle?.addEventListener('click', openDrawer);
        closeDrawer?.addEventListener('click', closeDrawerFunc);
        drawerOverlay.addEventListener('click', function() {
            closeMobileMenu();
            closeDrawerFunc();
        });

        document.querySelectorAll('#mobileMenu a, #mobileMenu button').forEach(function(el) {
            el.addEventListener('click', function() {
                if (window.innerWidth < 1024) {
                    closeMobileMenu();
                }
            });
        });
    </script>
    <partial name="_CookieConsent" />
</body>
</html>

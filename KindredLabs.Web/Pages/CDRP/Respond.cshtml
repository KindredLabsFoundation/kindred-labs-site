@page
@model KindredLabs.Web.Pages.CDRP.RespondModel
@{
    ViewData["Title"] = Model.Localizer["PageTitle"];
}

<div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-kindred-gold mb-8">@Model.Localizer["PageTitle"]</h1>

    @if (Model.Candidate == null)
    {
        <div class="bg-red-500/10 border border-red-500/20 text-red-500 p-4 rounded mb-8">
            @Model.Localizer["InvalidToken"]
        </div>
    }
    else if (Model.IsSuccess)
    {
        <div class="bg-green-500/10 border border-green-500/20 text-green-500 p-4 rounded mb-8">
            @Model.Localizer["SuccessMessage"]
        </div>
    }
    else
    {
        <div class="prose prose-invert max-w-none mb-8">
            <p>@Model.Localizer["Instructions"]</p>
        </div>

        <form method="post" class="space-y-8">
            <input type="hidden" name="token" value="@Model.Token" />
            
                    @foreach (var entry in Model.SupplementaryData)
            {
                <div class="bg-white/5 border border-white/10 rounded-lg p-6">
                    <h3 class="text-kindred-gold font-bold mb-2">@entry.Key</h3>
                    
                    <div class="mb-4 p-3 bg-white/5 rounded">
                        <p class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">@Model.Localizer["OriginalAnswer"]</p>
                        <p class="text-sm text-kindred-text">@(Model.CandidateFields.TryGetValue(entry.Key, out var val) ? val : "—")</p>
                    </div>

                    <div class="mb-4">
                        <p class="text-sm font-bold text-kindred-gold mb-2">@Model.Localizer["ReviewerQuestion"]</p>
                        <p class="text-sm text-kindred-text italic bg-kindred-dark/50 p-3 rounded border-l-2 border-kindred-gold">@entry.Value.Question</p>
                    </div>

                    <div>
                        <label for="responses_@entry.Key" class="block text-sm font-bold text-kindred-text mb-2">@Model.Localizer["YourResponse"]</label>
                        <textarea id="responses_@entry.Key" name="responses[@entry.Key]" class="w-full bg-white/10 border border-white/20 rounded px-4 py-3 text-kindred-text focus:outline-none focus:border-kindred-gold transition-colors" rows="4" required></textarea>
                    </div>
                </div>
            }

            <div class="flex justify-end">
                <button type="submit" class="bg-kindred-gold text-kindred-dark font-bold px-8 py-3 rounded hover:opacity-90 transition-opacity">
                    @Model.Localizer["SubmitButton"]
                </button>
            </div>
        </form>
    }
</div>
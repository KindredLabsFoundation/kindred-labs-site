@page
@using KindredLabs.Core.Constants
@using KindredLabs.Core.Models.CDRP
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model KindredLabs.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = Model.Localizer["PageTitle"];
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <h1 class="text-3xl font-ibm-plex text-kindred-gold mb-8">@Model.Localizer["PageTitle"]</h1>

    <!-- Tabs -->
    <div class="mb-8">
        <nav class="flex w-full">
            <button type="button" onclick="switchTab('users')" id="tab-users" class="flex-1 text-center py-3 font-medium text-sm transition-all duration-200 focus:outline-none">
                @Model.Localizer["UsersTab"]
            </button>
            <button type="button" onclick="switchTab('submissions')" id="tab-submissions" class="flex-1 text-center py-3 font-medium text-sm transition-all duration-200 focus:outline-none">
                @Model.Localizer["SubmissionsTab"]
            </button>
            <button type="button" onclick="switchTab('cdrp')" id="tab-cdrp" class="flex-1 text-center py-3 font-medium text-sm transition-all duration-200 focus:outline-none">
                @Model.Localizer["CdrpTab"]
            </button>
            <button type="button" onclick="switchTab('activity')" id="tab-activity" class="flex-1 text-center py-3 font-medium text-sm transition-all duration-200 focus:outline-none">
                @Model.Localizer["ActivityLogTab"]
            </button>
        </nav>
    </div>

    <div id="content-users" class="tab-content hidden w-full">
        <!-- Users Table -->
        <div class="overflow-x-auto">
            <table class="w-full divide-y divide-gray-700 table-fixed">
                <thead>
                    <tr>
                        <th class="w-[30px] px-6 py-3 text-left"></th>
                        <th class="w-[20%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Name"]</th>
                        <th class="w-[30%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Email"]</th>
                        <th class="w-[15%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Joined"]</th>
                        <th class="w-[15%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["TwoFactorStatus"]</th>
                        <th class="w-[20%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    @foreach (var user in Model.Users)
                    {
                        var isUserOwner = await UserManager.IsInRoleAsync(user, AppRoles.OwnerRole);
                        var isUserAdmin = await UserManager.IsInRoleAsync(user, AppRoles.AdminRole);
                        <tr class="@(user.IsSuspended ? "opacity-50 grayscale" : "")">
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                @if (isUserOwner) { <span class="text-kindred-gold font-bold text-sm">O</span> }
                                else if (isUserAdmin) { <span class="text-kindred-text opacity-60 text-sm">A</span> }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">
                                <div class="flex flex-col">
                                    <span>@user.FirstName @user.LastName</span>
                                    @if (user.IsDeleted && user.DeletedAt.HasValue)
                                    {
                                        <span class="text-[10px] text-red-500 font-bold uppercase tracking-tighter">
                                            Pending Deletion: @user.DeletedAt.Value.AddDays(14).ToShortDateString()
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300 max-w-[200px] truncate overflow-hidden" title="@user.Email">@user.Email</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">@user.CreatedAt.ToShortDateString()</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">
                                <span class="@(user.TwoFactorEnabled ? "text-green-500" : "text-gray-500")">
                                    @(user.TwoFactorEnabled ? "ON" : "OFF")
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <select onchange="handleActionChange(this, '@user.Id', '@user.FirstName @user.LastName')" class="bg-kindred-dark text-kindred-gold border border-gray-700 rounded text-xs px-2 py-1 focus:outline-none focus:ring-1 focus:ring-kindred-gold">
                                    <option value="">@Model.Localizer["SelectAction"]</option>
                                    <option value="View" data-url="?tab=users&userId=@user.Id">@Model.Localizer["View"]</option>
                                    @if (!isUserOwner)
                                    {
                                        @if (user.IsDeleted)
                                        {
                                            @if (Model.IsOwner)
                                            {
                                                <option value="RestoreUser">@Model.Localizer["Restore"]</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="@(user.IsSuspended ? "UnsuspendUser" : "SuspendUser")">@(user.IsSuspended ? Model.Localizer["Unsuspend"] : Model.Localizer["Suspend"])</option>
                                            @if (user.TwoFactorEnabled)
                                            {
                                                <option value="ResetTwoFactor">@Model.Localizer["Reset2FA"]</option>
                                            }
                                            <option value="DeleteUser">@Model.Localizer["Delete"]</option>
                                            @if (Model.IsOwner)
                                            {
                                                <option value="@(isUserAdmin ? "RevokeAdmin" : "AssignAdmin")">@(isUserAdmin ? Model.Localizer["RevokeAdmin"] : Model.Localizer["AssignAdmin"])</option>
                                            }
                                        }
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="content-submissions" class="tab-content hidden w-full">
        <div class="mb-4">
            <a asp-page-handler="DownloadSubmissions" asp-route-format="csv" class="text-kindred-gold hover:underline">@Model.Localizer["DownloadCSV"]</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full divide-y divide-gray-700 table-fixed">
                <thead>
                    <tr>
                        <th class="w-[20%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["FormType"]</th>
                        <th class="w-[20%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["SubmittedAt"]</th>
                        <th class="w-[40%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Hash"]</th>
                        <th class="w-[20%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["User"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    @foreach (var sub in Model.Submissions)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">@sub.FormType</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">@sub.SubmittedAt.ToString("g")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300 font-mono text-xs">@sub.ContentHash.Substring(0, 8)...</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">@(sub.User?.Email ?? Model.Localizer["Anonymous"])</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="content-cdrp" class="tab-content hidden w-full space-y-12">
        <!-- Applications Section -->
        <div id="cdrp-applications" class="cdrp-section">
            <h2 class="text-xl font-ibm-plex text-kindred-gold mb-4">Applications</h2>
            <div class="overflow-x-auto border border-gray-700 rounded-lg">
                <table class="w-full divide-y divide-gray-700 table-fixed border-collapse">
                    <colgroup>
                        <col class="w-[25%]">
                        <col class="w-[25%]">
                        <col class="w-[15%]">
                        <col class="w-[15%]">
                        <col class="w-[20%]">
                    </colgroup>
                    <thead class="bg-kindred-dark sticky top-0 z-10">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Name"]</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Email"]</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Status"]</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Submitted</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-800">
                        @foreach (var candidate in Model.CdrpApplications)
                        {
                            var statusDisplay = candidate.Status switch
                            {
                                CandidateStatus.Pending => "Pending",
                                CandidateStatus.UnderReview => "Under Review",
                                CandidateStatus.AwaitingResponse => "Awaiting Response",
                                _ => candidate.Status.ToString()
                            };

                            var nameClass = candidate.Status switch
                            {
                                CandidateStatus.Pending => "text-kindred-gold font-bold",
                                CandidateStatus.AwaitingResponse => "opacity-50",
                                _ => "text-gray-300"
                            };
                            
                            var isAwaiting = candidate.Status == CandidateStatus.AwaitingResponse;
                            var isTokenValid = candidate.ResponseTokenExpiry > DateTime.UtcNow;
                            var disableApproveDeny = isAwaiting && isTokenValid;

                            <tr>
                                <td class="px-6 py-4 text-sm truncate @nameClass" title="@candidate.Name">@candidate.Name</td>
                                <td class="px-6 py-4 text-sm text-gray-400 truncate" title="@candidate.Email">@candidate.Email</td>
                                <td class="px-6 py-4 text-sm text-gray-300 truncate" title="@statusDisplay">@statusDisplay</td>
                                <td class="px-6 py-4 text-sm text-gray-300 truncate">@candidate.SubmittedAt.ToShortDateString()</td>
                                <td class="px-6 py-4 text-sm font-medium">
                                    <select onchange="handleCdrpActionChange(this, '@candidate.Id', '@candidate.Name')" class="bg-kindred-dark text-kindred-gold border border-gray-700 rounded text-xs px-2 py-1 focus:outline-none focus:ring-1 focus:ring-kindred-gold w-full">
                                        <option value="">@Model.Localizer["SelectAction"]</option>
                                        <option value="View" data-url="?tab=cdrp&candidateId=@candidate.Id">@Model.Localizer["View"]</option>
                                        @if (isAwaiting)
                                        {
                                            <option value="ResendQuestions">Resend Questions</option>
                                            <option value="SendNewLink">Send New Link</option>
                                        }
                                        <option value="ApproveCandidate" disabled="@(disableApproveDeny ? "disabled" : null)">@Model.Localizer["Approve"]</option>
                                        <option value="DenyCandidate" disabled="@(disableApproveDeny ? "disabled" : null)">@Model.Localizer["Deny"]</option>
                                        <option value="DeleteCandidate">@Model.Localizer["Delete"]</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Active Members Section -->
        <div id="cdrp-active" class="cdrp-section">
            <h2 class="text-xl font-ibm-plex text-kindred-gold mb-4">Active Members</h2>
            <div class="overflow-x-auto border border-gray-700 rounded-lg">
                <table class="w-full divide-y divide-gray-700 table-fixed border-collapse">
                    <colgroup>
                        <col class="w-[20%]">
                        <col class="w-[20%]">
                        <col class="w-[15%]">
                        <col class="w-[15%]">
                        <col class="w-[10%]">
                        <col class="w-[20%]">
                    </colgroup>
                    <thead class="bg-kindred-dark sticky top-0 z-10">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Name"]</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Email"]</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Approved</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Term Expires</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Renewal</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-800">
                        @foreach (var member in Model.CdrpActiveMembers)
                        {
                            var canRenew = member.TermExpiresAt <= DateTime.UtcNow.AddDays(30) && member.RenewalRequested;
                            <tr>
                                <td class="px-6 py-4 text-sm truncate text-gray-300" title="@member.Name">@member.Name</td>
                                <td class="px-6 py-4 text-sm text-gray-400 truncate" title="@member.Email">@member.Email</td>
                                <td class="px-6 py-4 text-sm text-gray-300 truncate">@(member.ApprovedAt?.ToShortDateString() ?? "—")</td>
                                <td class="px-6 py-4 text-sm text-gray-300 truncate">@(member.TermExpiresAt?.ToShortDateString() ?? "—")</td>
                                <td class="px-6 py-4 text-sm text-gray-300 truncate">@(member.RenewalRequested ? "Yes" : "No")</td>
                                <td class="px-6 py-4 text-sm font-medium">
                                    <select onchange="handleCdrpActionChange(this, '@member.Id', '@member.Name')" class="bg-kindred-dark text-kindred-gold border border-gray-700 rounded text-xs px-2 py-1 focus:outline-none focus:ring-1 focus:ring-kindred-gold w-full">
                                        <option value="">@Model.Localizer["SelectAction"]</option>
                                        <option value="View" data-url="?tab=cdrp&candidateId=@member.Id">@Model.Localizer["View"]</option>
                                        <option value="RenewTerm" disabled="@(!canRenew ? "disabled" : null)">Renew Term</option>
                                        <option value="RetireCandidate">Retire</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Retired Section -->
        <div id="cdrp-retired" class="cdrp-section">
            <h2 class="text-xl font-ibm-plex text-kindred-gold mb-4">Retired</h2>
            <div class="overflow-x-auto border border-gray-700 rounded-lg">
                <table class="w-full divide-y divide-gray-700 table-fixed border-collapse">
                    <colgroup>
                        <col class="w-[33.33%]">
                        <col class="w-[33.33%]">
                        <col class="w-[33.34%]">
                    </colgroup>
                    <thead class="bg-kindred-dark sticky top-0 z-10">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Name"]</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Email"]</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Retired Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-800">
                        @foreach (var member in Model.CdrpRetiredMembers)
                        {
                            <tr>
                                <td class="px-6 py-4 text-sm truncate text-gray-300" title="@member.Name">@member.Name</td>
                                <td class="px-6 py-4 text-sm text-gray-400 truncate" title="@member.Email">@member.Email</td>
                                <td class="px-6 py-4 text-sm text-gray-300 truncate">@(member.RetiredAt?.ToShortDateString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Denied Section -->
        <div id="cdrp-denied" class="cdrp-section">
            <h2 class="text-xl font-ibm-plex text-kindred-gold mb-4">Denied</h2>
            <div class="overflow-x-auto border border-gray-700 rounded-lg">
                <table class="w-full divide-y divide-gray-700 table-fixed border-collapse">
                    <colgroup>
                        <col class="w-[25%]">
                        <col class="w-[25%]">
                        <col class="w-[25%]">
                        <col class="w-[25%]">
                    </colgroup>
                    <thead class="bg-kindred-dark sticky top-0 z-10">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Name"]</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Email"]</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Denied Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Eligible to Reapply</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-800">
                        @foreach (var candidate in Model.CdrpDeniedCandidates)
                        {
                            <tr>
                                <td class="px-6 py-4 text-sm truncate text-gray-300" title="@candidate.Name">@candidate.Name</td>
                                <td class="px-6 py-4 text-sm text-gray-400 truncate" title="@candidate.Email">@candidate.Email</td>
                                <td class="px-6 py-4 text-sm text-gray-300 truncate">@(candidate.DeniedAt?.ToShortDateString() ?? "—")</td>
                                <td class="px-6 py-4 text-sm text-gray-300 truncate">@(candidate.DeniedAt?.AddMonths(6).ToString("MMMM d, yyyy") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="content-activity" class="tab-content hidden w-full">
        <div class="mb-4 space-x-4">
            <a asp-page-handler="DownloadActivityLog" asp-route-format="csv" class="text-kindred-gold hover:underline">@Model.Localizer["DownloadCSV"]</a>
            <a asp-page-handler="DownloadActivityLog" asp-route-format="txt" class="text-kindred-gold hover:underline">@Model.Localizer["DownloadTXT"]</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full divide-y divide-gray-700 table-fixed">
                <thead>
                    <tr>
                        <th class="w-[20%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Admin"]</th>
                        <th class="w-[20%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["TargetUser"]</th>
                        <th class="w-[25%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Action"]</th>
                        <th class="w-[20%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["Date"]</th>
                        <th class="w-[15%] px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">@Model.Localizer["IP"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    @foreach (var log in Model.ActivityLogs)
                    {
                        var actionDisplay = log.Action switch
                        {
                            SecurityEventTypes.AdminRoleAssigned => "Assigned Admin Role",
                            SecurityEventTypes.AdminRoleRevoked => "Revoked Admin Role",
                            SecurityEventTypes.AccountSuspended => "Suspended Account",
                            SecurityEventTypes.AccountUnsuspended => "Unsuspended Account",
                            SecurityEventTypes.TwoFactorReset => "Reset Two-Factor Authentication",
                            "UserDeleted" => "Deleted Account",
                            _ => log.Action
                        };

                        var adminDisplay = !string.IsNullOrEmpty(log.AdminUser?.FirstName) 
                            ? $"{log.AdminUser.FirstName} {log.AdminUser.LastName}" 
                            : log.AdminUser?.Email;
                            
                        var targetDisplay = log.TargetUser == null ? "N/A" 
                            : !string.IsNullOrEmpty(log.TargetUser.FirstName) 
                                ? $"{log.TargetUser.FirstName} {log.TargetUser.LastName}" 
                                : log.TargetUser.Email;
                                
                        var ipDisplay = log.IpAddress == "::1" || log.IpAddress == "127.0.0.1" ? "localhost" : log.IpAddress;

                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">@adminDisplay</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">@targetDisplay</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">
                                <span class="block font-medium">@actionDisplay</span>
                                <span class="block text-xs text-gray-500">@log.Description</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">@log.PerformedAt.ToString("g")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-300">@ipDisplay</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- User Details Drawer -->
@if (Model.SelectedUser != null)
{
    <div id="viewOverlay" class="fixed left-0 right-0 bottom-0 bg-black/60 z-[60]" style="top: 64px;" onclick="location.href='?tab=users'"></div>
    <div class="fixed inset-y-0 right-0 top-[64px] pl-10 max-w-full flex h-[calc(100vh-64px)] z-[65]">
        <div class="w-screen max-w-md">
            <div class="h-full flex flex-col bg-kindred-dark shadow-xl border-l border-white/10">
                <div class="px-4 pt-4 pb-6 sm:px-6 border-b border-white/10 flex justify-between items-center">
                    <h2 class="text-xl font-ibm-plex text-kindred-gold" id="slide-over-title">@Model.SelectedUser.FirstName @Model.SelectedUser.LastName</h2>
                    <a href="?tab=users" class="text-gray-400 hover:text-gray-200">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </a>
                </div>
                <div id="drawerContent" class="relative flex-1 py-6 px-4 sm:px-6 space-y-8 overflow-y-auto overscroll-contain">
                            <!-- Profile Card -->
                            <div class="bg-white/5 border border-white/10 rounded-lg p-6">
                                <h3 class="text-sm font-bold text-kindred-gold uppercase tracking-wider mb-4">Profile</h3>
                                <dl class="space-y-4">
                                    <div>
                                        <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Email</dt>
                                        <dd class="text-sm text-kindred-text flex items-center gap-2">
                                            @Model.SelectedUser.Email
                                            @if (Model.SelectedUser.EmailConfirmed)
                                            {
                                                <span class="px-1.5 py-0.5 text-[10px] font-bold bg-green-500/20 text-green-500 border border-green-500/30 rounded uppercase tracking-tighter">Verified</span>
                                            }
                                            else
                                            {
                                                <span class="px-1.5 py-0.5 text-[10px] font-bold bg-red-500/20 text-red-500 border border-red-500/30 rounded uppercase tracking-tighter">Unverified</span>
                                            }
                                        </dd>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Organization</dt>
                                            <dd class="text-sm text-kindred-text">@(Model.SelectedUser.Organization ?? "—")</dd>
                                        </div>
                                        <div>
                                            <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Job Title</dt>
                                            <dd class="text-sm text-kindred-text">@(Model.SelectedUser.JobTitle ?? "—")</dd>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Joined</dt>
                                            <dd class="text-sm text-kindred-text">@Model.SelectedUser.CreatedAt.ToShortDateString()</dd>
                                        </div>
                                        <div>
                                            <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Submissions</dt>
                                            <dd class="text-sm text-kindred-text">@Model.SubmissionCount</dd>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">2FA Status</dt>
                                            <dd class="text-sm @(Model.SelectedUser.TwoFactorEnabled ? "text-green-500" : "text-gray-500")">
                                                @(Model.SelectedUser.TwoFactorEnabled ? "Enabled" : "Disabled")
                                            </dd>
                                        </div>
                                        <div>
                                            <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Suspended</dt>
                                            <dd class="text-sm @(Model.SelectedUser.IsSuspended ? "text-red-500" : "text-gray-500")">
                                                @(Model.SelectedUser.IsSuspended ? "Yes" : "No")
                                            </dd>
                                        </div>
                                    </div>
                                </dl>
                            </div>

                            <!-- Security Events -->
                            <div class="bg-white/5 border border-white/10 rounded-lg p-6">
                                <h3 class="text-sm font-bold text-kindred-gold uppercase tracking-wider mb-4">Security Events</h3>
                                <ul class="divide-y divide-white/10 text-xs">
                                    @foreach (var log in Model.UserSecurityLogs.Take(5))
                                    {
                                        <li class="py-3 first:pt-0 last:pb-0">
                                            @{
                                                var eventLabel = log.EventType switch
                                                {
                                                    "RecoveryCodeUsed" => "Recovery Code Used",
                                                    "RecoveryCodesGenerated" => "Recovery Codes Generated",
                                                    "TwoFactorEnabled" => "Two-Factor Enabled",
                                                    "TwoFactorDisabled" => "Two-Factor Disabled",
                                                    "AuthenticatorReset" => "Authenticator Reset",
                                                    "LoginSuccess" => "Login Successful",
                                                    "LoginFailed" => "Login Failed",
                                                    "PasswordChanged" => "Password Changed",
                                                    "EmailChanged" => "Email Changed",
                                                    "AccountSuspended" => "Account Suspended",
                                                    "AccountUnsuspended" => "Account Unsuspended",
                                                    "AdminRoleAssigned" => "Admin Role Assigned",
                                                    "AdminRoleRevoked" => "Admin Role Revoked",
                                                    "TwoFactorReset" => "Reset Two-Factor Authentication",
                                                    _ => log.EventType
                                                };
                                            }
                                            <span class="block text-kindred-text font-medium">@eventLabel</span>
                                            <span class="block text-kindred-text/70 mt-1">@log.Description</span>
                                            <span class="block text-kindred-text/40 mt-1">@log.PerformedAt.ToString("g") - @log.IpAddress</span>
                                        </li>
                                    }
                                    @if (!Model.UserSecurityLogs.Any())
                                    {
                                        <li class="py-2 text-kindred-text/40 italic">No security events recorded</li>
                                    }
                                </ul>
                            </div>

                            <!-- Login History -->
                            <div class="bg-white/5 border border-white/10 rounded-lg p-6">
                                <h3 class="text-sm font-bold text-kindred-gold uppercase tracking-wider mb-4">Login History</h3>
                                <ul class="divide-y divide-white/10 text-xs">
                                    @foreach (var log in Model.UserLoginHistory.Take(5))
                                    {
                                        <li class="py-3 first:pt-0 last:pb-0 flex justify-between items-center">
                                            <span class="text-kindred-text">@log.LoginAt.ToString("g")</span>
                                            <span class="text-kindred-text/40">@log.IpAddress</span>
                                        </li>
                                    }
                                    @if (!Model.UserLoginHistory.Any())
                                    {
                                        <li class="py-2 text-kindred-text/40 italic">No login history recorded</li>
                                    }
                                </ul>
                            </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- CDRP Candidate Details Drawer -->
@if (Model.SelectedCandidate != null)
{
    <div id="viewOverlay" class="fixed left-0 right-0 bottom-0 bg-black/60 z-[60]" style="top: 64px;" onclick="location.href='?tab=cdrp'"></div>
    <div class="fixed inset-y-0 right-0 top-[64px] pl-10 max-w-full flex h-[calc(100vh-64px)] z-[65]">
        <div class="w-screen max-w-2xl">
            <div class="h-full flex flex-col bg-kindred-dark shadow-xl border-l border-white/10">
                <div class="px-4 pt-4 pb-6 sm:px-6 border-b border-white/10 flex justify-between items-center">
                    <h2 class="text-xl font-ibm-plex text-kindred-gold">@Model.CandidateFields["Name"]</h2>
                    <a href="?tab=cdrp" class="text-gray-400 hover:text-gray-200">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </a>
                </div>
                <div id="drawerContent" class="relative flex-1 py-6 px-4 sm:px-6 space-y-8 overflow-y-auto overscroll-contain">
                    <form method="post" asp-page-handler="SendSupplementaryRequest" id="supplementaryForm">
                        <input type="hidden" name="candidateId" value="@Model.SelectedCandidate.Id" />
                        
                        <!-- Profile Card -->
                        <div class="bg-white/5 border border-white/10 rounded-lg p-6 mb-8">
                            <h3 class="text-sm font-bold text-kindred-gold uppercase tracking-wider mb-4">Profile Information</h3>
                            <dl class="space-y-4">
                                @{
                                    var profileFields = new[] { "Name", "Email", "Organization", "JobTitle", "ReferralSource" };
                                    foreach (var fieldName in profileFields)
                                    {
                                        if (Model.CandidateFields.TryGetValue(fieldName, out var value) && !string.IsNullOrEmpty(value))
                                        {
                                            var label = fieldName switch
                                            {
                                                "JobTitle" => "Job Title",
                                                "ReferralSource" => "Referral Source",
                                                _ => fieldName
                                            };
                                            <div>
                                                <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">@label</dt>
                                                <dd class="text-sm text-kindred-text">@value</dd>
                                            </div>
                                        }
                                    }
                                }
                            </dl>

                            <!-- Term Management Info -->
                            @if (Model.SelectedCandidate.Status == CandidateStatus.Active || 
                                 Model.SelectedCandidate.Status == CandidateStatus.Retired || 
                                 Model.SelectedCandidate.Status == CandidateStatus.Denied ||
                                 Model.SelectedCandidate.Status == CandidateStatus.Approved)
                            {
                                <div class="mt-6 pt-6 border-t border-white/10">
                                    <h4 class="text-xs font-bold text-kindred-gold uppercase tracking-wider mb-4">Lifecycle Status</h4>
                                    <dl class="grid grid-cols-2 gap-4">
                                        @if (Model.SelectedCandidate.ApprovedAt.HasValue)
                                        {
                                            <div>
                                                <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Approved At</dt>
                                                <dd class="text-sm text-kindred-text">@Model.SelectedCandidate.ApprovedAt.Value.ToShortDateString()</dd>
                                            </div>
                                        }
                                        @if (Model.SelectedCandidate.TermExpiresAt.HasValue)
                                        {
                                            <div>
                                                <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Term Expires</dt>
                                                <dd class="text-sm text-kindred-text @(Model.SelectedCandidate.TermExpiresAt.Value < DateTime.UtcNow ? "text-red-400" : "")">
                                                    @Model.SelectedCandidate.TermExpiresAt.Value.ToShortDateString()
                                                </dd>
                                            </div>
                                        }
                                        @if (Model.SelectedCandidate.RetiredAt.HasValue)
                                        {
                                            <div>
                                                <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Retired At</dt>
                                                <dd class="text-sm text-kindred-text">@Model.SelectedCandidate.RetiredAt.Value.ToShortDateString()</dd>
                                            </div>
                                        }
                                        @if (Model.SelectedCandidate.DeniedAt.HasValue)
                                        {
                                            <div>
                                                <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Denied At</dt>
                                                <dd class="text-sm text-kindred-text">@Model.SelectedCandidate.DeniedAt.Value.ToShortDateString()</dd>
                                            </div>
                                        }
                                        @if (Model.SelectedCandidate.RenewalRequested)
                                        {
                                            <div>
                                                <dt class="text-xs text-kindred-text/50 uppercase tracking-wider mb-1">Renewal Requested</dt>
                                                <dd class="text-sm text-kindred-gold font-bold">Yes</dd>
                                            </div>
                                        }
                                    </dl>
                                </div>
                            }
                        </div>

                        @{
                            var questionFields = new[] { "Perspectives", "Background", "Interest", "Conflicts" };
                            foreach (var fieldName in questionFields)
                            {
                                if (Model.CandidateFields.TryGetValue(fieldName, out var value))
                                {
                                    <div class="mb-8 p-4 bg-white/5 border border-white/10 rounded-lg">
                                        <h3 class="text-xs font-bold text-kindred-gold uppercase tracking-wider mb-2">@fieldName</h3>
                                        <p class="text-sm text-kindred-text mb-4">@value</p>

                                        @if (Model.SupplementaryData.TryGetValue(fieldName, out var entry))
                                        {
                                            <div class="mt-4 p-3 bg-kindred-dark/50 border-l-2 border-kindred-gold rounded">
                                                <p class="text-xs font-bold text-kindred-gold mb-1">Reviewer Question:</p>
                                                <p class="text-sm text-kindred-text italic mb-2">@entry.Question</p>
                                                
                                                @if (!string.IsNullOrEmpty(entry.Response))
                                                {
                                                    <p class="text-xs font-bold text-green-500 mb-1">Candidate Response:</p>
                                                    <p class="text-sm text-green-400 font-medium">@entry.Response</p>
                                                }
                                            </div>
                                        }

                                        @if (!Model.SupplementaryData.Any() &&
                                             Model.SelectedCandidate.Status != CandidateStatus.AwaitingResponse && 
                                             Model.SelectedCandidate.Status != CandidateStatus.Approved && 
                                             Model.SelectedCandidate.Status != CandidateStatus.Denied)
                                        {
                                            <div class="mt-4 pt-4 border-t border-white/10">
                                                <label class="flex items-center gap-2 cursor-pointer">
                                                    <input type="checkbox" onchange="toggleQuestionField(this, '@fieldName')" class="rounded bg-white/10 border-white/20 text-kindred-gold focus:ring-kindred-gold" />
                                                    <span class="text-xs text-kindred-text/60">I have a question about this answer</span>
                                                </label>
                                                <div id="question-@fieldName" class="hidden mt-3">
                                                    <textarea name="questions[@fieldName]" placeholder="Type your question here..." class="w-full bg-kindred-dark border border-white/20 rounded px-3 py-2 text-sm text-kindred-text focus:outline-none focus:border-kindred-gold transition-colors" rows="2"></textarea>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }

                        @if (!Model.SupplementaryData.Any() &&
                             Model.SelectedCandidate.Status != CandidateStatus.AwaitingResponse && 
                             Model.SelectedCandidate.Status != CandidateStatus.Approved && 
                             Model.SelectedCandidate.Status != CandidateStatus.Denied)
                        {
                            <div class="sticky bottom-0 bg-kindred-dark py-4 border-t border-white/10">
                                <button type="submit" class="text-kindred-gold hover:underline font-bold">Send Questions</button>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Overlay -->
<div id="confirmOverlay" class="fixed left-0 right-0 bottom-0 bg-black/60 z-[60] hidden" style="top: 64px;"></div>

<!-- Modal -->
<div id="confirmModal" class="fixed z-[70] hidden bg-kindred-dark border border-white/10 rounded-lg p-6 shadow-2xl" style="top: 50%; left: 50%; transform: translate(-50%, -50%);">
    <h3 class="text-kindred-gold font-bold mb-4">Confirm Action</h3>
    <p id="confirmMessage" class="text-kindred-text mb-6"></p>
    <div class="flex items-center justify-between">
        <button id="confirmActionBtn" onclick="document.getElementById('confirmationForm').submit()" class="bg-transparent border-none p-0 text-kindred-gold hover:opacity-70 transition-opacity cursor-pointer font-ui text-base">Confirm</button>
        <button id="cancelActionBtn" onclick="closeModal()" class="bg-transparent border-none p-0 text-kindred-text hover:text-kindred-gold transition-colors cursor-pointer font-ui text-base">Cancel</button>
    </div>
</div>

<form id="confirmationForm" method="post" class="hidden">
    <input type="hidden" name="userId" id="modalUserId" />
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        function switchTab(tabId) {
            // Update buttons
            document.querySelectorAll('nav:not(.cdrp-subcontent nav) button').forEach(btn => {
                btn.classList.remove('bg-white/10', 'border-t-2', 'border-kindred-gold', 'text-white');
                btn.classList.add('text-gray-400');
            });
            const activeBtn = document.getElementById('tab-' + tabId);
            if (activeBtn) {
                activeBtn.classList.add('bg-white/10', 'border-t-2', 'border-kindred-gold', 'text-white');
                activeBtn.classList.remove('text-gray-400');
            }

            // Update content
            document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
            const activeContent = document.getElementById('content-' + tabId);
            if (activeContent) {
                activeContent.classList.remove('hidden');
            }

            // Persist tab in URL without reload
            const url = new URL(window.location);
            url.searchParams.set('tab', tabId);
            window.history.replaceState({}, '', url);
        }

        function toggleQuestionField(checkbox, fieldName) {
            const field = document.getElementById('question-' + fieldName);
            if (checkbox.checked) {
                field.classList.remove('hidden');
            } else {
                field.classList.add('hidden');
                field.querySelector('textarea').value = '';
            }
        }

        function handleCdrpActionChange(select, candidateId, candidateName) {
            const action = select.value;
            if (!action) return;

            if (action === 'View') {
                const url = select.options[select.selectedIndex].getAttribute('data-url');
                window.location.href = url;
                select.value = "";
                return;
            }

            const actionLabel = select.options[select.selectedIndex].text;
            const message = `You are about to ${actionLabel.toLowerCase()} ${candidateName}. Are you sure?`;
            
            const modalCandidateId = document.getElementById('modalUserId'); // Reuse existing hidden input
            const confirmMessage = document.getElementById('confirmMessage');
            const confirmationForm = document.getElementById('confirmationForm');
            const confirmOverlay = document.getElementById('confirmOverlay');
            const confirmModal = document.getElementById('confirmModal');

            if (modalCandidateId) {
                modalCandidateId.name = "candidateId";
                modalCandidateId.value = candidateId;
            }
            if (confirmMessage) confirmMessage.innerText = message;
            
            // Map actions to their respective handlers
            let handlerName = action;
            if (action === "ApproveCandidate") handlerName = "ApproveCandidate";
            if (action === "DenyCandidate") handlerName = "DenyCandidate";
            if (action === "DeleteCandidate") handlerName = "DeleteCandidate";
            if (action === "ResendQuestions") handlerName = "ResendQuestions";
            if (action === "SendNewLink") handlerName = "SendNewLink";
            if (action === "RenewTerm") handlerName = "RenewTerm";
            if (action === "RetireCandidate") handlerName = "RetireCandidate";

            if (confirmationForm) confirmationForm.action = `?handler=${handlerName}`;
            
            // Only View and Save Notes are not destructive, but everything in handleCdrpActionChange select is except View.
            // The requirement says: "All destructive actions (Delete, Deny, Retire) require a confirmation modal following the existing pattern."
            // In my implementation, Approve, ResendQuestions, SendNewLink, and RenewTerm also show the modal for safety.
            
            if (confirmOverlay) confirmOverlay.classList.remove('hidden');
            if (confirmModal) confirmModal.classList.remove('hidden');
            
            // Reset dropdown
            select.value = "";
        }

        function handleActionChange(select, userId, userName) {
            const action = select.value;
            if (!action) return;

            if (action === 'View') {
                const url = select.options[select.selectedIndex].getAttribute('data-url');
                window.location.href = url;
                select.value = "";
                return;
            }

            const actionLabel = select.options[select.selectedIndex].text;
            const message = `@Model.Localizer["ConfirmMessagePrefix"] ${actionLabel.toLowerCase()} ${userName}. @Model.Localizer["AreYouSure"]`;
            
            const modalUserId = document.getElementById('modalUserId');
            if (modalUserId) {
                modalUserId.name = "userId";
                modalUserId.value = userId;
            }
            const confirmMessage = document.getElementById('confirmMessage');
            const confirmationForm = document.getElementById('confirmationForm');
            const confirmOverlay = document.getElementById('confirmOverlay');
            const confirmModal = document.getElementById('confirmModal');

            if (confirmMessage) confirmMessage.innerText = message;
            if (confirmationForm) confirmationForm.action = `?handler=${action}`;
            if (confirmOverlay) confirmOverlay.classList.remove('hidden');
            if (confirmModal) confirmModal.classList.remove('hidden');
            
            // Reset dropdown
            select.value = "";
        }

        function closeModal() {
            const confirmOverlay = document.getElementById('confirmOverlay');
            const confirmModal = document.getElementById('confirmModal');
            if (confirmOverlay) confirmOverlay.classList.add('hidden');
            if (confirmModal) confirmModal.classList.add('hidden');
        }

        // Initialize from URL or default
        document.addEventListener('DOMContentLoaded', () => {
            const params = new URLSearchParams(window.location.search);
            const tab = params.get('tab') || '@Model.ActiveTab';
            switchTab(tab);

            // Prevent scroll propagation for view drawer
            const drawer = document.getElementById('drawerContent');
            if (drawer) {
                drawer.addEventListener('wheel', (e) => {
                    const { scrollTop, scrollHeight, clientHeight } = drawer;
                    const delta = e.deltaY;
                    if ((delta < 0 && scrollTop <= 0) || (delta > 0 && scrollTop + clientHeight >= scrollHeight)) {
                        e.preventDefault();
                    }
                }, { passive: false });
            }
        });
    </script>
}
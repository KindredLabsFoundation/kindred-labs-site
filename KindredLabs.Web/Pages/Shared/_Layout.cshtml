@using Microsoft.AspNetCore.Identity
@using KindredLabs.Core.Models.Identity
@using Microsoft.Extensions.Localization
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<Pages.Shared._LayoutModel> Localizer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kindred Labs Foundation</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Kindred Labs</a>
                <div class="nav-links">
                    <a asp-page="/Index">@Localizer["Home"]</a>
                    <a asp-page="/Codex">@Localizer["Codex"]</a>
                    <a asp-page="/Framework/Index">@Localizer["Framework"]</a>
                    <a asp-page="/CDRP/Index">@Localizer["CDRP"]</a>
                    <a asp-page="/About">@Localizer["About"]</a>
                    <a asp-page="/Contact">@Localizer["Contact"]</a>
                </div>
                <div class="auth-links">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <a asp-page="/Account/Manage/Index" title="Manage">@User.Identity?.Name</a>
                        <form class="form-inline" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                            <button type="submit" class="nav-link btn-logout">@Localizer["Logout"]</button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/Account/Register">@Localizer["Register"]</a>
                        <a asp-page="/Account/Login">@Localizer["Login"]</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            &copy; @DateTime.Now.Year - Kindred Labs Foundation
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

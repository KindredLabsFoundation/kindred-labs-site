@page
@model KindredLabs.Web.Pages.Account.Manage.TwoFactorModel
@{
    ViewData["Title"] = Model.Localizer["PageTitle"];
}

<div class="max-w-7xl mx-auto px-4 py-12">
    <div class="mb-8">
        <a asp-page="/Account/Index" asp-route-culture="@(HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en")" class="text-kindred-gold hover:opacity-70 transition-opacity flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            @Model.Localizer["BackToAccount"]
        </a>
    </div>

    <h1 class="text-3xl font-wordmark text-kindred-text mb-8">@ViewData["Title"]</h1>

    @if (TempData["StatusMessage"] != null)
    {
        <div id="statusToast" class="fixed bottom-4 end-4 z-50 bg-kindred-gold text-kindred-dark px-6 py-4 rounded shadow-lg flex items-center gap-4">
            <span>@TempData["StatusMessage"]</span>
            <button onclick="document.getElementById('statusToast').remove()" class="bg-transparent border-none p-0 text-kindred-dark hover:opacity-70 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>
        <script>
            setTimeout(() => {
                const toast = document.getElementById('statusToast');
                if (toast) toast.remove();
            }, 5000);
        </script>
    }

    <div class="space-y-12">
        <section>
            @if (Model.TwoFactorEnabled)
            {
                <div class="flex items-center justify-between py-4 border-b border-kindred-text/10">
                    <span class="text-kindred-text">@Model.Localizer["TwoFactorEnabled"]</span>
                    <form asp-page-handler="Disable" method="post">
                        <button type="submit" class="bg-transparent border-none p-0 text-kindred-gold hover:opacity-70 transition-opacity cursor-pointer font-ui text-base">
                            @Model.Localizer["DisableLink"]
                        </button>
                    </form>
                </div>
                <div class="py-4">
                    <a asp-page="/Account/Manage/RecoveryCodes" asp-route-culture="@(HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en")" class="text-kindred-gold hover:opacity-70 transition-opacity font-ui text-base">
                        @Model.Localizer["ViewRecoveryCodesLink"]
                    </a>
                </div>
            }
            else
            {
                <div class="space-y-8">
                    <div>
                        <p class="text-kindred-text opacity-70 mb-6">@Model.Localizer["Instructions"]</p>
                        
                        <div class="flex flex-col md:flex-row gap-8 items-start">
                            <div class="bg-white p-4 rounded shadow-lg">
                                <img src="data:image/png;base64,@Model.QrCodeBase64" alt="QR Code" class="w-48 h-48" />
                            </div>
                            
                            <div class="space-y-4">
                                <p class="text-sm font-bold text-kindred-text uppercase tracking-wider">@Model.Localizer["ManualEntryLabel"]</p>
                                <code class="block bg-kindred-dark p-4 rounded text-kindred-gold font-mono text-lg tracking-widest uppercase">
                                    @Model.AuthenticatorKey
                                </code>
                                <p class="text-xs text-kindred-text opacity-50">@Model.Localizer["ManualEntryNote"]</p>
                            </div>
                        </div>
                    </div>

                    <div class="max-w-sm">
                        <form asp-page-handler="Enable" method="post" class="space-y-4">
                            <div class="space-y-2">
                                <label asp-for="Code" class="block text-sm font-medium text-kindred-text">@Model.Localizer["VerificationCodeLabel"]</label>
                                <input asp-for="Code" class="w-full bg-kindred-dark border-none rounded px-4 py-2 text-kindred-text focus:ring-1 focus:ring-kindred-gold outline-none" autocomplete="off" />
                                <span asp-validation-for="Code" class="text-red-400 text-xs"></span>
                            </div>
                            
                            <div class="pt-2">
                                <button type="submit" class="bg-transparent border-none p-0 text-kindred-gold hover:opacity-70 transition-opacity cursor-pointer font-ui text-base">
                                    @Model.Localizer["EnableLink"]
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

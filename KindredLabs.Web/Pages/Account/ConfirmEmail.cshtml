@page
@model ConfirmEmailModel
@inject IStringLocalizer<KindredLabs.Web.Resources.Pages.Account.ConfirmEmail> Localizer

@{
    ViewData["Title"] = Localizer["Confirm email"];
}

<div class="max-w-md mx-auto px-4 py-16">
    <h1 class="text-2xl font-bold text-kindred-gold mb-8">@ViewData["Title"]</h1>
    <div class="text-kindred-text">
        <partial name="_StatusMessage" model="Model.StatusMessage" />
    </div>
</div>
